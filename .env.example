# ---- Kalshi credentials (leave empty => DEMO mode, replays real Madrid tape) ----
# Create at kalshi.com -> Account & security -> API Keys.
KALSHI_API_KEY_ID=
# Paste the FULL PEM private key (Railway supports multiline env values), e.g.
# -----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# The app auto-repairs mangled newlines, but if you get a "MalformedFraming"
# error, use the bulletproof base64 form below instead (leave this blank).
KALSHI_PRIVATE_KEY=
# RECOMMENDED if pasting the PEM gives trouble: base64 of the whole .key file.
#   macOS/Linux:  base64 -w0 mykey.key   (macOS: base64 -i mykey.key | tr -d '\n')
# Paste the single-line output here; no newline problems possible.
KALSHI_PRIVATE_KEY_B64=

# ---- Mode & storage ----
MODE=auto            # auto | live | demo
DATA_DIR=./data      # on Railway attach a Volume and point this at its mount path
# Required for kill/flatten controls. Use a long random value (e.g. `openssl rand -hex 32`).
ADMIN_TOKEN=

# ---- Strategy (Gate A frozen defaults; override to experiment) ----
DL_MIN=0.8
LEVELS_MIN=5
SIZE_MIN=200
CONF_MS=50
CONF_SIGN=true
PRICE_CAP=58
NOTIONAL_USD=100
TARGET=90
TIMEOUT_S=180
LOCKOUT_S=120
LATE_ONLY=false
LATE_WINDOW_MIN=20
USE_STOP=false

# ---- Realistic paper adapter (opt-in; strategy and signal logic are unchanged) ----
PAPER_EXECUTION_V2=false
PAPER_ENTRY_LATENCY_MS=150
PAPER_EXIT_LATENCY_MS=150
PAPER_EXECUTION_POLL_MS=5

# ---- Read-only Kalshi score-vs-market latency experiment ----
# This does not affect signals, entries, exits, or paper fills.
GOAL_LATENCY_OBSERVER=true
GOAL_LATENCY_POLL_MS=250
GOAL_LATENCY_LOOKBACK_S=10
GOAL_LATENCY_AFTER_S=2

# ---- Demo replay ----
DEMO_SPEED=25
DEMO_LOOP=true
