# ---- Kalshi credentials (leave empty => DEMO mode, replays real Madrid tape) ----
# Create at kalshi.com -> Account & security -> API Keys.
KALSHI_API_KEY_ID=
# Paste the FULL PEM private key (Railway supports multiline env values), e.g.
# -----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# The app auto-repairs mangled newlines, but if you get a "MalformedFraming"
# error, use the bulletproof base64 form below instead (leave this blank).
KALSHI_PRIVATE_KEY=
# RECOMMENDED if pasting the PEM gives trouble: base64 of the whole .key file.
#   macOS/Linux:  base64 -w0 mykey.key   (macOS: base64 -i mykey.key | tr -d '\n')
# Paste the single-line output here; no newline problems possible.
KALSHI_PRIVATE_KEY_B64=

# ---- Mode & storage ----
MODE=auto            # auto | live | demo
DATA_DIR=./data      # on Railway attach a Volume and point this at its mount path
# Required for kill/flatten controls. Use a long random value (e.g. `openssl rand -hex 32`).
ADMIN_TOKEN=

# ---- Strategy (Gate A frozen defaults; override to experiment) ----
DL_MIN=0.8
LEVELS_MIN=5
SIZE_MIN=200
CONF_MS=50
CONF_SIGN=true
PRICE_CAP=58
NOTIONAL_USD=100
TARGET=90
TIMEOUT_S=180
LOCKOUT_S=120
LATE_ONLY=false
LATE_WINDOW_MIN=20
USE_STOP=false

# ---- Price-only late-score sleeve (paper-only, no match/event feed) ----
# off = Gate A only; enforce = price-only only; parallel = independently paper-test both.
PRICE_ONLY_SLEEVE_MODE=off
SLEEVE_START_BEFORE_EXPIRY_MIN=2
SLEEVE_AFTER_EXPIRY_MIN=12
SLEEVE_BASELINE_MS=1800
SLEEVE_MAX_BASELINE_AGE_MS=6000
SLEEVE_TRIPLET_FRESH_MS=5000
SLEEVE_MAX_SPREAD_C=8
SLEEVE_MIN_TEAM_GAIN_PP=0.15
SLEEVE_MIN_DRAW_GAIN_PP=0.15
SLEEVE_MIN_TEAM_POST=0.45
SLEEVE_MIN_DRAW_POST=0.40
SLEEVE_MAX_SIBLING_RISE_PP=0.02
SLEEVE_MIN_EXPLAINED=0.85
SLEEVE_SCRATCH_ARM_C=4
SLEEVE_SCRATCH_BUFFER_C=0.5
SLEEVE_UNKNOWN_FEE_BUFFER_C=2
SLEEVE_TRAIL_ARM_C=6
SLEEVE_TRAIL_MIN_C=2
SLEEVE_TRAIL_FRAC=0.45
SLEEVE_REVERSAL_C=2
SLEEVE_OSCILLATION_WINDOW_S=4
SLEEVE_OSCILLATION_CROSSES=3
SLEEVE_MAX_OSCILLATION_EFFICIENCY=0.35
SLEEVE_TIMEOUT_S=30

# ---- Sub-threshold research capture (collection only; never trades) ----
# Bursts that clear this floor but not the Gate A thresholds above are recorded
# with outcome `subthreshold`, so the detector thresholds can be re-fitted from
# the study database instead of only by replaying the raw feed. They are never
# confirmed, never dispatched to a sleeve, and never counted toward a kill gate.
SUBTHRESHOLD_CAPTURE=true
SUBTHRESHOLD_DL_MIN=0.3
SUBTHRESHOLD_LEVELS_MIN=3
SUBTHRESHOLD_SIZE_MIN=50
# Per-market rate limit on observations, whatever the trade rate.
SUBTHRESHOLD_COOLDOWN_S=5

# ---- Realistic paper adapter (opt-in; strategy and signal logic are unchanged) ----
PAPER_EXECUTION_V2=false
PAPER_ENTRY_LATENCY_MS=150
PAPER_EXIT_LATENCY_MS=150
PAPER_EXECUTION_POLL_MS=5

# ---- Read-only Kalshi score-vs-market latency experiment ----
# This does not affect signals, entries, exits, or paper fills.
GOAL_LATENCY_OBSERVER=true
GOAL_LATENCY_POLL_MS=250
GOAL_LATENCY_LOOKBACK_S=10
GOAL_LATENCY_AFTER_S=2
# Diagnostic nearest-event window only; it never changes entry or exit decisions.
EVENT_MATCH_WINDOW_S=20
# Maximum age of a persisted match-clock observation used by the 88+ gate.
MATCH_CLOCK_MAX_AGE_MS=2500

# ---- Demo replay ----
DEMO_SPEED=25
DEMO_LOOP=true

# ---- Sibling confirmation transport patience ----
# How long an unconfirmed candidate waits for its sibling's frame. Coherence is
# judged on exchange timestamps (CONF_MS), so waiting longer cannot admit a pair
# the exchange clock says was too far apart. A confirmation arriving later than
# CONF_TRADE_MAX_AGE_S is recorded as `confirmed_late` and never traded, so the
# longer wait is additive evidence rather than a trading change.
CONF_WAIT_S=2.0
CONF_TRADE_MAX_AGE_S=0.2
