# ---- Kalshi credentials (leave empty => DEMO mode, replays real Madrid tape) ----
# Create at kalshi.com -> Account & security -> API Keys.
KALSHI_API_KEY_ID=
# Paste the FULL PEM private key (Railway supports multiline env values), e.g.
# -----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# The app auto-repairs mangled newlines, but if you get a "MalformedFraming"
# error, use the bulletproof base64 form below instead (leave this blank).
KALSHI_PRIVATE_KEY=
# RECOMMENDED if pasting the PEM gives trouble: base64 of the whole .key file.
#   macOS/Linux:  base64 -w0 mykey.key   (macOS: base64 -i mykey.key | tr -d '\n')
# Paste the single-line output here; no newline problems possible.
KALSHI_PRIVATE_KEY_B64=

# ---- Mode & storage ----
MODE=auto            # auto | live | demo
DATA_DIR=./data      # on Railway attach a Volume and point this at its mount path
# Required for kill/flatten controls. Use a long random value (e.g. `openssl rand -hex 32`).
ADMIN_TOKEN=

# ---- Strategy (Gate A frozen defaults; override to experiment) ----
DL_MIN=0.8
LEVELS_MIN=5
SIZE_MIN=200
CONF_MS=50
CONF_SIGN=true
PRICE_CAP=58
# Minimum executable price. Below this the entry is refused as `rejected_floor`
# while the signal and its forward path are still recorded, mirroring PRICE_CAP
# at the other end. A fixed dollar notional buys contracts as 1/price, so cheap
# legs carried 73% of all contract exposure and lost 22 of 27. Set 0 to disable.
PRICE_FLOOR=35
NOTIONAL_USD=100
TARGET=90
TIMEOUT_S=180
LOCKOUT_S=120
LATE_ONLY=false
LATE_WINDOW_MIN=20
USE_STOP=false

# ---- Price-only late-score sleeve (paper-only, no match/event feed) ----
# off = Gate A only; enforce = price-only only; parallel = independently paper-test both.
PRICE_ONLY_SLEEVE_MODE=off
SLEEVE_START_BEFORE_EXPIRY_MIN=2
SLEEVE_AFTER_EXPIRY_MIN=12
SLEEVE_BASELINE_MS=1800
SLEEVE_MAX_BASELINE_AGE_MS=6000
SLEEVE_TRIPLET_FRESH_MS=5000
SLEEVE_MAX_SPREAD_C=8
SLEEVE_MIN_TEAM_GAIN_PP=0.15
SLEEVE_MIN_DRAW_GAIN_PP=0.15
SLEEVE_MIN_TEAM_POST=0.45
SLEEVE_MIN_DRAW_POST=0.40
SLEEVE_MAX_SIBLING_RISE_PP=0.02
SLEEVE_MIN_EXPLAINED=0.85
SLEEVE_SCRATCH_ARM_C=4
SLEEVE_SCRATCH_BUFFER_C=0.5
SLEEVE_UNKNOWN_FEE_BUFFER_C=2
SLEEVE_TRAIL_ARM_C=6
SLEEVE_TRAIL_MIN_C=2
SLEEVE_TRAIL_FRAC=0.45
SLEEVE_REVERSAL_C=2
SLEEVE_OSCILLATION_WINDOW_S=4
SLEEVE_OSCILLATION_CROSSES=3
SLEEVE_MAX_OSCILLATION_EFFICIENCY=0.35
SLEEVE_TIMEOUT_S=30

# ---- Sub-threshold research capture (collection only; never trades) ----
# Bursts that clear this floor but not the Gate A thresholds above are recorded
# with outcome `subthreshold`, so the detector thresholds can be re-fitted from
# the study database instead of only by replaying the raw feed. They are never
# confirmed, never dispatched to a sleeve, and never counted toward a kill gate.
SUBTHRESHOLD_CAPTURE=true
SUBTHRESHOLD_DL_MIN=0.3
SUBTHRESHOLD_LEVELS_MIN=3
SUBTHRESHOLD_SIZE_MIN=50
# Per-market rate limit on observations, whatever the trade rate.
SUBTHRESHOLD_COOLDOWN_S=5

# ---- Realistic paper adapter (opt-in; strategy and signal logic are unchanged) ----
PAPER_EXECUTION_V2=false
PAPER_ENTRY_LATENCY_MS=150
PAPER_EXIT_LATENCY_MS=150
PAPER_EXECUTION_POLL_MS=5
# Maximum age, in ms, of the order book a paper entry may fill against, measured
# from that book's arrival in this process to the fill. 0 = RECORD ONLY: the age
# is measured and persisted on every fill and no entry is ever refused, so the
# default reproduces today's behaviour exactly. Above zero, an entry whose book
# is older than the bound is finalised as `stale_book` and counted as a
# confirmed outcome, exactly like `no_book`. This one DOES refuse entries, so it
# is part of the strategy configuration identity and changes `config_id`.
PAPER_MAX_BOOK_AGE_MS=0

# ---- WebSocket arrival queue bounds (transport, not strategy) ----
# The queue between the socket reader and the frame consumer. It was unbounded,
# which on 2026-09-05 let a consumer stall grow to 896,017 queued frames and
# `order_arrival_ms` p95 2,280,666 ms (38 minutes) while the reader kept up
# (feed lag p50 63-148 ms) and 3.77 GB of an 8 GB limit was held. The bot
# "entered" against book state 41-79 minutes old for finished matches and booked
# the settlement queued behind it, fabricating about +$281 of paper profit.
# PAPER_MAX_BOOK_AGE_MS=5000 was set in production as the immediate mitigation
# before this bound existed; it refuses the fill, it does not bound the queue.
#
# Frames beyond this depth are discarded oldest-first, counted, written to
# `feed_events` as `queue_overflow` and to the raw stream as a marker, and any
# market whose order-book frames were discarded is invalidated and
# re-snapshotted. 0 = unbounded (the old behaviour).
WS_QUEUE_MAX=20000
# Only `oldest` is implemented: the newest market state is the only state worth
# trading on. Any other value is normalised to `oldest`, never to unbounded.
WS_QUEUE_DROP_POLICY=oldest
# At most one overflow summary per this many seconds, so an overflow storm
# cannot become the bottleneck. A newly affected market is always disclosed
# immediately, because its book must be invalidated before a fill can use it.
WS_QUEUE_OVERFLOW_REPORT_S=1
# Stall guard: a queue held at or above WS_QUEUE_STALL_DEPTH for longer than
# WS_QUEUE_STALL_S forces a reconnect, which drains the queue and re-subscribes
# for fresh snapshots. 0 depth derives half of WS_QUEUE_MAX, and leaves the
# guard off while the queue is unbounded.
WS_QUEUE_STALL_S=60
WS_QUEUE_STALL_DEPTH=0
WS_QUEUE_STALL_POLL_S=1
# Floor on the interval between two FORCED reconnects, so the guard cannot
# thrash a feed that reconnects straight back into the same backlog.
WS_RECONNECT_MIN_INTERVAL_S=120
# How long the frame consumer may hold the event loop before yielding. This
# replaced a fixed 16-frames-per-turn yield, which capped throughput at 16
# frames per event-loop turn however cheap a frame was: at the scheduler lag
# measured in production (p50 19 ms, p95 165 ms) that is 97-800 frames/s,
# against ~19,000 frames/s of actual capacity with CPU at 0.10 of 8 vCPU.
# 5 ms is small beside that lag, so nothing else on the loop waits materially
# longer. 0 restores yield-after-every-frame.
WS_CONSUMER_SLICE_MS=5
# Minimum interval before recovery re-asks for a market's snapshot. Recovery
# used to send one get_snapshot per rejected delta and re-request every market
# on every gap, which under load made recovery the largest single load on the
# process it was recovering.
WS_SNAPSHOT_RETRY_S=5

# ---- Read-only Kalshi score-vs-market latency experiment ----
# This does not affect signals, entries, exits, or paper fills.
GOAL_LATENCY_OBSERVER=true
GOAL_LATENCY_POLL_MS=250
GOAL_LATENCY_LOOKBACK_S=10
GOAL_LATENCY_AFTER_S=2
# Diagnostic nearest-event window only; it never changes entry or exit decisions,
# and it is deliberately excluded from the strategy configuration identity.
# Was 20, guessed against a documented 18.635 s observation lag -- about 1.4 s of
# margin. Measured since: provider `occurence_ts` to first observation p50 15 s,
# and goal observation minus bot entry typically +12..+50 s, so at 20 s most
# genuinely goal-driven trades recorded `no_nearby_same_match_event`.
EVENT_MATCH_WINDOW_S=90
# Maximum age of a persisted match-clock observation used by the 88+ gate.
# A provider minute changes once per 60 s, and staleness is directionally safe
# here (minute only increases, so a stale reading can only refuse an eligible
# candidate). Ten seconds bounds the one real risk: entering just after a final
# whistle the stale clock has not yet reflected. Measured live age is p50 6.1 s.
MATCH_CLOCK_MAX_AGE_MS=10000
# Match minute at which the price-only sleeve becomes eligible. Was hard-coded
# at 88. Set deliberately BELOW the estimated optimum, not at it: the timing
# study back-calibrates the shock inflection to roughly minute 81-85, and a
# floor inside that band would censor the data exactly where the answer lies.
# 80 puts the whole plausible band inside the sample and roughly doubles
# eligible clock coverage, so the threshold can be fitted forward from Kalshi's
# own provider clock. See docs/RESEARCH_LOG_2026-09-04_POLYMARKET_TIMING.md.
SLEEVE_MIN_MINUTE=80
# How often event -> milestone mappings are re-resolved, on their own task.
CLOCK_MAPPING_INTERVAL_S=15
# How often the observer flushes the buffered "last seen at" refreshes for
# provider events it has ALREADY recorded. A new event still inserts
# immediately; only the repeat-sighting timestamp is batched. Writing one per
# already-seen event per poll was the dominant cost of the clock poll: measured
# interval 5.7 s p50 / 30 s max against a 250 ms target on 2026-09-04.
# Observability only -- it cannot change a decision, so it is not part of the
# strategy configuration identity.
PROVIDER_EVENT_FLUSH_S=60

# ---- Raw feed archive on Cloudflare R2 (storage only; never a trading input) ----
# The Railway volume is finite: 4.00 GB used of 4.08 GB on 2026-09-05, 2.94 GB of
# it raw segments (176 files), growing ~300 MB/day. With this on, a SEALED hourly
# segment is uploaded to R2, verified (returned ETag == local md5, then HEAD
# content-length == local size), and only then may its local copy be pruned. The
# hour being written to is never uploaded and never pruned, and nothing is ever
# deleted locally before its remote copy is verified. Off, or without
# credentials, the whole feature is inert.
RAW_ARCHIVE_ENABLED=false
# Cloudflare account id -> https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# R2 API token (Object Read & Write on the bucket). SECRET: never commit it,
# never log it; it is excluded from every export and every API response.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=football-bot-raw-feed
# Optional endpoint override; leave empty in production. Tests point it at a
# local stub so no test needs the network.
R2_ENDPOINT=
# How long a VERIFIED segment stays on the volume before it is pruned to R2.
# It stays downloadable through /api/export/raw/{name} either way.
RAW_LOCAL_RETENTION_HOURS=48
# Emergency floor: below this much free space on DATA_DIR, verified segments are
# pruned oldest-first regardless of retention. This is what stops a full volume
# from becoming silent write loss in the study database. 0 disables the floor.
RAW_ARCHIVE_MIN_FREE_MB=512
# Upload attempts before a segment is left alone. It is KEPT on the volume, never
# deleted, and reported through /api/archive with its last error.
RAW_ARCHIVE_MAX_ATTEMPTS=5
RAW_ARCHIVE_INTERVAL_S=60
# ---- Forward-path collection (observation only; never changes a decision) ----
# Every signal, accepted or declined, is followed for SIGNAL_PATH_WINDOW_S so a
# decline is a labelled observation rather than a dead record. Set the window to
# 0 to disable collection without a deploy.
SIGNAL_PATH_WINDOW_S=300
SIGNAL_PATH_MAX_TRACKED=400
# Path sampling policy. Every change is recorded for the first
# PATH_THIN_AFTER_S after the anchor -- the window the reaction happens in --
# then at most one row per PATH_THIN_INTERVAL_MS. A new peak or trough is ALWAYS
# recorded regardless of thinning, and store.BID_PATH_MAX_SAMPLES (4,000) stays
# the hard backstop. The old flat cap was a budget spent in arrival order, so the
# busiest markets exhausted it first: samples=3999 on every La Liga trade and
# signal, collapsing the 300 s window to 60-130 s exactly where activity was
# highest.
PATH_THIN_AFTER_S=10
PATH_THIN_INTERVAL_MS=250

# ---- Demo replay ----
DEMO_SPEED=25
DEMO_LOOP=true

# ---- Sibling confirmation transport patience ----
# How long an unconfirmed candidate waits for its sibling's frame. Coherence is
# judged on exchange timestamps (CONF_MS), so waiting longer cannot admit a pair
# the exchange clock says was too far apart. A confirmation arriving later than
# CONF_TRADE_MAX_AGE_S is recorded as `confirmed_late` and never traded, so the
# longer wait is additive evidence rather than a trading change.
CONF_WAIT_S=2.0
CONF_TRADE_MAX_AGE_S=0.2
